#!/bin/bash
# Regenerate the theme's terminal color files from colors.toml.
#
# Omarchy always derives the terminal cursor from bright_foreground, and
# fsociety wants it in the accent red, so the theme ships its own
# ghostty.conf, alacritty.toml, kitty.conf and foot.ini. Shipping a file stops
# Omarchy generating it, so run this after every colors.toml edit.
set -euo pipefail

theme_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# omarchy-theme-set-templates writes to a fixed path under $HOME. A throwaway
# HOME points it somewhere safe and also leaves out any user templates.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
out="$scratch/.local/state/omarchy/current/next-theme"
mkdir -p "$out"
cp "$theme_dir/colors.toml" "$out/"
HOME="$scratch" omarchy-theme-set-templates

colors=$(omarchy-theme-color --file "$theme_dir/colors.toml" --all)
value() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' <<<"$colors"; }
accent=$(value accent)
background=$(value background)

# The renderer exits 0 even when it finds no templates (a wrong OMARCHY_PATH),
# so check its output before touching anything in the theme.
files=(ghostty.conf alacritty.toml kitty.conf foot.ini)
for f in "${files[@]}"; do
  [[ -s $out/$f ]] || { echo "regen-terminals: Omarchy rendered no $f (check OMARCHY_PATH)" >&2; exit 1; }
done
[[ $accent == \#* && $background == \#* ]] || { echo "regen-terminals: no accent/background in colors.toml" >&2; exit 1; }

# Edit in the scratch dir, then move all four into place at the end, so a
# failure never leaves the theme with a truncated file.
sed -i "s|^cursor-color = .*|cursor-color = $accent\ncursor-text = $background|" "$out/ghostty.conf"
sed -i "s|^cursor = \".*\"|cursor = \"$accent\"|" "$out/alacritty.toml"
sed -i "s|^cursor #.*|cursor $accent|" "$out/kitty.conf"
sed -i "s|^cursor=.*|cursor=${background#\#} ${accent#\#}|" "$out/foot.ini"

for f in "${files[@]}"; do
  cp "$out/$f" "$theme_dir/$f"
done
